# go-agent-claw 环境配置模板（不包含真实密钥）
# 推荐：首次使用 cp -n env.export .env，然后编辑 .env；CLI 会自动加载。
# 也可在编辑本地副本后执行 source ./.env，向当前终端导出配置。
# 请将真实密钥只保存在已被 Git 忽略的 .env，不要填回此模板提交。
# CLI 参数（如 -model、-mode、-auto）通过命令行设置，不在此文件中设置。

# 必填：默认使用 DeepSeek，只需填写这一项即可运行默认 CLI。
export DEEPSEEK_API_KEY=""
# 可选：不设置时使用渠道默认端点。使用网关时填其完整 API 路径。
# export DEEPSEEK_BASE_URL="https://api.deepseek.com"

# 可选渠道：CLI 用 -provider openai，或 -model 指定模型。
# export OPENAI_API_KEY=""
# export OPENAI_BASE_URL="https://api.openai.com/v1/"
# export OPENAI_ORG_ID=""
# export OPENAI_PROJECT_ID=""

# 可选渠道：CLI 用 -provider zhipu -model 指定该渠道实际可用的模型。
# export ZHIPU_API_KEY=""
# export ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"

# 可选代理：按本机实际端口调整，不需要代理时保留注释。
# export HTTPS_PROXY="http://127.0.0.1:7891"
# export HTTP_PROXY="http://127.0.0.1:7891"
# export NO_PROXY="localhost,127.0.0.1,::1"

# 可选观测：默认开启；观测台启动命令见 docs/observability.md。
# export CLAW_OBSERVE="off"
# export CLAW_OBSERVE_DIR="/绝对路径/观测目录"
# 费用单价为用户配置的示例，非官方报价；不配置时未知费用不会记为零。
# export CLAW_MODEL_PRICES='{"模型名":{"currency":"CNY","input_per_million":1,"output_per_million":2}}'

# 可选诊断：默认 metadata；on_error 显式开启本地失败请求脱敏副本保存。
# export CLAW_REQUEST_DIAGNOSTICS="metadata"
# export CLAW_REQUEST_DIAGNOSTICS_DIR="/绝对路径/请求诊断目录"

# 以下仅用于独立飞书服务 go run ./cmd/agentops，CLI 不读取这两个模型变量。
# export CLAW_PROVIDER="deepseek"
# export CLAW_MODEL="deepseek-v4.1-flash-1017"
# export FEISHU_APP_ID=""
# export FEISHU_APP_SECRET=""
# export FEISHU_VERIFY_TOKEN=""
# export FEISHU_ENCRYPT_KEY=""
# export FEISHU_AGENTOPS_CONFIG="/绝对路径/agentops.json"
# export FEISHU_LISTEN_ADDR="127.0.0.1:48080"
